<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
body{background:#f5f7fb;font-family:Segoe UI}
.sidebar{height:100vh;background:#111827;color:#fff;padding:20px;position:fixed;width:220px}
.sidebar a{display:flex;gap:10px;color:#cbd5e1;padding:10px;border-radius:8px;text-decoration:none}
.sidebar a:hover,.active{background:#2563eb;color:#fff}
.main{margin-left:230px;padding:20px}
.card{border:none;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.05)}
.topbar{background:#fff;padding:10px 20px;border-radius:10px;margin-bottom:20px}
.table thead{background:#eef2f7}
.badge-success{background:green}
.badge-warning{background:orange}
.badge-danger{background:red}
@media(max-width:768px){
.sidebar{display:none}
.main{margin:0}
}
</style>
</head>

<body>

<div class="sidebar">
<h4><i class="fa fa-hospital"></i> DrSeba</h4>
<a class="active" onclick="showPage('dashboard')"><i class="fa fa-chart-line"></i> Dashboard</a>
<a onclick="showPage('employees')"><i class="fa fa-users"></i> Employees</a>
<a onclick="showPage('doctors')"><i class="fa fa-user-doctor"></i> Doctors & Hospitals</a>
<a onclick="showPage('appointments')"><i class="fa fa-calendar"></i> Appointments</a>
<a onclick="showPage('payments')"><i class="fa fa-money-bill"></i> Payments</a>
<a onclick="showPage('reports')"><i class="fa fa-chart-pie"></i> Reports</a>
</div>

<div class="main">

<div class="topbar d-flex justify-content-between">
<h5>Admin Dashboard</h5>
<div>
<button class="btn btn-sm btn-outline-primary">English</button>
<button class="btn btn-sm btn-outline-secondary">বাংলা</button>
<i class="fa fa-bell ms-3"></i> Admin
</div>
</div>

<!-- DASHBOARD -->
<div id="dashboard" class="page">
<div class="row g-3">
<div class="col-md-3"><div class="card p-3"><h6>Total Doctors</h6><h3>120</h3></div></div>
<div class="col-md-3"><div class="card p-3"><h6>Appointments</h6><h3>450</h3></div></div>
<div class="col-md-3"><div class="card p-3"><h6>Revenue</h6><h3>৳50000</h3></div></div>
<div class="col-md-3"><div class="card p-3"><h6>Patients</h6><h3>300</h3></div></div>
</div>

<div class="card mt-4 p-3">
<h5>Recent Appointments</h5>
<table class="table">
<tr><td>Karim</td><td>10AM</td><td><span class="badge bg-success">Confirmed</span></td></tr>
<tr><td>Salma</td><td>11AM</td><td><span class="badge bg-warning">Pending</span></td></tr>
</table>
</div>
</div>

<!-- EMPLOYEES -->
<div id="employees" class="page d-none">
<div class="d-flex justify-content-between mb-3">
<input class="form-control w-50" placeholder="Search">
<button class="btn btn-primary">Add Employee</button>
</div>

<table class="table">
<thead>
<tr>
<th>ID</th><th>Name</th><th>Role</th><th>Hospital</th><th>Join Date</th><th>Appointments Managed</th><th>Action</th>
</tr>
</thead>
<tbody>
<tr>
<td>EMP1</td><td>Rahim</td><td>Manager</td><td>DMCH</td><td>2023</td><td>120</td>
<td><button class="btn btn-sm btn-warning">Edit</button> <button class="btn btn-sm btn-danger">Delete</button></td>
</tr>
</tbody>
</table>
</div>

<!-- DOCTORS -->
<div id="doctors" class="page d-none">
<div class="d-flex justify-content-between mb-3">
<input class="form-control w-50" placeholder="Search Doctor">
<button class="btn btn-primary">Add Doctor</button>
</div>

<table class="table">
<thead>
<tr>
<th>ID</th><th>Name</th><th>Age</th><th>Speciality</th><th>Reg Date</th><th>Hospital</th><th>Hospital ID</th><th>Fee</th><th>Time</th><th>Service</th><th>Patient Charge</th><th>Count</th><th>%</th><th>Status</th><th>Action</th>
</tr>
</thead>
<tbody>
<tr>
<td>D1</td><td>Dr. A</td><td>40</td><td>Cardio</td><td>2022</td><td>DMCH</td><td>H1</td><td>500</td><td>5PM</td><td>50</td><td>100</td><td>200</td><td>10%</td>
<td><span class="badge bg-success">Active</span></td>
<td><button class="btn btn-sm btn-warning">Edit</button></td>
</tr>
</tbody>
</table>
</div>

<!-- APPOINTMENTS -->
<div id="appointments" class="page d-none">

<div class="d-flex gap-2 mb-3">
<button class="btn btn-outline-primary">Distributed</button>
<button class="btn btn-outline-secondary">Non-Distributed</button>
</div>

<div class="d-flex justify-content-between mb-3">
<input class="form-control w-50" placeholder="Search Patient/Doctor">
<select class="form-select w-25">
<option>All Status</option>
<option>Pending</option>
<option>Confirmed</option>
</select>
</div>

<table class="table">
<thead>
<tr>
<th>ID</th><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Type</th><th>Service</th><th>Manager</th><th>Doctor</th><th>Final</th><th>Action</th>
</tr>
</thead>
<tbody>
<tr>
<td>A1</td><td>Karim</td><td>Dr A</td><td>10-10</td><td>10AM</td><td>Online</td><td>50</td>
<td>Approved</td><td>Accepted</td><td>Confirmed</td>
<td><button class="btn btn-sm btn-danger">Cancel</button></td>
</tr>
</tbody>
</table>
</div>

<!-- PAYMENTS -->
<div id="payments" class="page d-none">
<div class="row g-3">
<div class="col-md-4"><div class="card p-3"><h6>Total Revenue</h6><h3>৳50000</h3></div></div>
<div class="col-md-4"><div class="card p-3"><h6>Monthly</h6><h3>৳10000</h3></div></div>
<div class="col-md-4"><div class="card p-3"><h6>Pending</h6><h3>৳2000</h3></div></div>
</div>

<table class="table mt-3">
<thead>
<tr>
<th>ID</th><th>Patient</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th>
</tr>
</thead>
<tbody>
<tr>
<td>P1</td><td>Karim</td><td>500</td><td>bKash</td><td><span class="badge bg-success">Paid</span></td><td>2024</td>
</tr>
</tbody>
</table>
</div>

<!-- REPORT -->
<div id="reports" class="page d-none">
<div class="row g-3">
<div class="col-md-6"><div class="card p-3"><h6>Monthly Appointments</h6><h3>400</h3></div></div>
<div class="col-md-6"><div class="card p-3"><h6>Revenue</h6><h3>৳60000</h3></div></div>
</div>
</div>

</div>

<script>
function showPage(id){
document.querySelectorAll('.page').forEach(p=>p.classList.add('d-none'));
document.getElementById(id).classList.remove('d-none');
}
</script>

</body>
</html>
